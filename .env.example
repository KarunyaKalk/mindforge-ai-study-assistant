# Port for the Node.js Express backend proxy server
PORT=3001

# Groq API Key (Fast, free-tier LLM API provider using Llama 3.3)
# Get a free key at: https://console.groq.com/
GROQ_API_KEY=

# Optional model choice (e.g., llama-3.3-70b-versatile or llama3-70b-8192)
GROQ_MODEL=llama-3.3-70b-versatile
