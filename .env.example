# Port for the Node.js Express backend proxy server
PORT=3001

# Google Gemini API Key (Required for real LLM model calls)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Optional default model choice (e.g. gemini-1.5-flash or gemini-2.0-flash-exp)
GEMINI_MODEL=gemini-1.5-flash
